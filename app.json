{
  "expo": {
    "name": "Finotify",
    "slug": "finotify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "image": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
        "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },

    "ios": {
      "supportsTablet": true
    },"android": {
  "adaptiveIcon": {
    "foregroundImage": "./assets/adaptive-icon.png",
    "backgroundColor": "#0d1117"
  },
  "softwareKeyboardLayoutMode": "pan",
  "permissions": [
    "READ_SMS",
    "RECEIVE_SMS"
  ],
  "edgeToEdgeEnabled": true,
  "package": "com.anonymous.myapp"
},
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00354f31-2d73-4fb7-9808-838f56002217"
      }
    },
    "owner": "zisan412"
  }
}
