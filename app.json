{
  "expo": {
    "name": "finotify",
    "slug": "finotify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ic.png",
    "image": "./assets/ic.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ic.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a63bcd5"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic.png",
        "backgroundColor": "#000"
      },
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.myapp"
    },
    "web": {
      "favicon": "./assets/ic.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00354f31-2d73-4fb7-9808-838f56002217"
      }
    },
    "owner": "zisan412"
  }
}
